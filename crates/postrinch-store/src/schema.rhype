// Postrinch's store schema.
//
// `@on_delete` on a relation field says what happens to objects of THIS type
// when the object they point at is deleted: deleting an Account cascades to
// its labels and threads, and a thread to its messages; deleting a Label or
// a Person only drops the links to it.
//
// Changing this file changes the store's format: see format.rs.
//
// Objects that a provider identifies within an account carry a `key`,
// "<account address key>\u001f<provider id>", unique across the store.

type Account {
    // EmailAddress::key(); `address` keeps it as written.
    key: String @unique
    address: String
    display_name: String
    provider: String
    state: Json
    // ImapSettings for an IMAP account (no secrets); null for Google.
    imap: Json
    // The provider's sync position (Gmail's historyId), written only after
    // everything before it has been stored.
    sync_cursor: String
    // What sends have shown about whether an IMAP account's provider files
    // sent mail in Sent itself (sent_filing.rs); null until a send has.
    sent_filing: Json
    labels: [Label] @inverse(Label.account)
    threads: [Thread] @inverse(Thread.account)
    imap_folders: [ImapFolder] @inverse(ImapFolder.account)
}

type Label {
    key: String @unique
    account: Account @on_delete(cascade)
    provider_id: String
    name: String
    kind: Json
    // LabelVisibility and Option<LabelColor>, as the provider has them.
    visibility: Json
    color: Json
    // LabelPrefs: what the person changed here. Sync never writes it.
    prefs: Json
    messages: [Message] @inverse(Message.labels)
}

type Thread {
    key: String @unique
    account: Account @on_delete(cascade)
    provider_id: String
    // When its latest message arrived, so a mailbox lists in order without
    // reading every message (threads.rs). Null in a store written before
    // threads kept it, until the thread is next listed or added to.
    latest: DateTime
    // When its latest message that is not a draft arrived, and whether that
    // message is the account's answer (answered.rs). Null until worked out.
    last_message: DateTime
    replied_last: Bool
    messages: [Message] @inverse(Message.thread)
}

type Person {
    // EmailAddress::key(): the address, lowercased.
    address: String @unique
    name: String
    sent: [Message] @inverse(Message.from)
    received: [Message] @inverse(Message.recipients)
}

// rhypedb copies an object into the reverse entry of a link whenever the
// object has a to-one relation besides that link, and into the index of
// every @indexed field. A message has eight-odd links and several indexed
// fields, so Message holds only what is small, and what a message says is
// in its MessageContent. Its account is reached through its thread.
// `schema_keeps_message_small` guards both.
type Message {
    key: String @unique
    thread: Thread @on_delete(cascade)
    labels: [Label] @on_delete(remove)
    from: [Person] @on_delete(remove)
    recipients: [Person] @on_delete(remove)
    provider_id: String
    rfc_message_id: String @indexed
    subject: String
    snippet: String
    received: DateTime @indexed
    unread: Bool @indexed
    starred: Bool @indexed
    has_attachments: Bool
    size: u64
    // SHA-256 of the raw message in the blob store, hex; null until fetched.
    raw_sha256: String
    // Whether the content's body_text and attachments are known (false:
    // headers only).
    downloaded: Bool @indexed
    content: [MessageContent] @inverse(MessageContent.message)
}

// What a message says, kept apart from Message so that rhypedb's copies of
// a message (one in the reverse entry of each of its links, one in each
// @indexed field's index) stay small. MessageContent has one to-one
// relation and no @indexed field, so rhypedb copies it nowhere.
type MessageContent {
    key: String @unique
    message: Message @on_delete(cascade)
    // Subject, names and addresses, and body, for full-text search.
    search_text: String @fulltext(analyzer: "english")
    body_text: String
    headers: Json
    attachments: Json
}

// The store's format version, one object with key "store". See format.rs.
type StoreInfo {
    key: String @unique
    version: u32
}

// A view the person made or changed (views.rs): `name` holds its key,
// `settings` the whole view. `query` repeats the view's search.
type SavedView {
    name: String @unique
    query: String
    settings: Json
}

// A change made here to some messages (MessageChange), waiting to reach
// the provider, and then kept until a sync has passed it. Every store write
// of a message's labels and flags applies the account's entries over what
// it writes, in `seq` order, so sync never undoes a change on its way out.
// See outbox.rs.
type OutboxEntry {
    // "<account address key>\u001f<seq, 20 digits>".
    key: String @unique
    account: String
    seq: u64
    // The provider ids of the messages, a JSON list.
    messages: Json
    change: Json
    created: DateTime
    attempts: u32
    // Why the last attempt failed; null after none has.
    error: String
    // When the provider took it; null while it waits.
    sent: DateTime
}

// Mail written here on its way out: a message to send, a draft to keep with
// the provider, or an agent's proposal waiting for the person. See
// outgoing.rs.
type Outgoing {
    // "<account address key>\u001f<seq, 20 digits>".
    key: String @unique
    account: String
    seq: u64
    // OutgoingKind.
    kind: Json
    // The Draft.
    draft: Json
    created: DateTime
    attempts: u32
    // Why the last attempt failed; null after none has.
    error: String
    // Whether the provider refused it for good.
    refused: Bool
    // SendStage: how far an IMAP account's send got; null for queued.
    stage: Json
    // The recipients (EmailAddress list) the server took it for in earlier
    // transactions of a send split by the server's limit; null for none.
    delivered_to: Json
    // While `stage` is data_sent: the recipients that transaction was for.
    sending_to: Json
    // The recipients (PutOff list) the server put off on earlier attempts
    // (outgoing_put_off.rs); null for none.
    put_off: Json
}

// One account's mail rules (postrinch-rules): `settings` as the account's
// settings message holds them, shared by every computer; `local` what this
// computer alone knows (how far its runner got, the filters made in Gmail
// itself). Keyed by EmailAddress::key().
type AccountRules {
    account: String @unique
    settings: Json
    local: Json
}

// One of an account's calendars (calendars.rs): `info` is its
// CalendarInfo, `sync_token` where the sync of its events got to (null
// before the first, or after the calendar said to start again).
type Calendar {
    // "<account address key>\u001f<calendar id>".
    key: String @unique
    account: String
    info: Json
    sync_token: String
}

// An event as its calendar keeps it: an EventRecord (a single event, a
// repeating series, or one changed or cancelled time of one).
type Event {
    // "<calendar key>\u001f<event id>".
    key: String @unique
    calendar: String
    record: Json
}

// An agent's answer to an invitation, waiting for the person to give it or
// not (answers.rs): `proposal` is the ProposedAnswer.
type ProposedAnswer {
    // "<account address key>\u001f<message provider id>".
    key: String @unique
    account: String
    proposal: Json
}

// An agent's change to the person's calendars that would tell other
// people, waiting for the person (answers.rs): `proposal` is the
// EventProposal.
type ProposedEvent {
    // "<account address key>\u001f<id, 20 digits>".
    key: String @unique
    account: String
    proposal: Json
}

// One folder of an IMAP account as sync knows it (imap_state.rs): the label
// it is shown as, its name on the server and how far sync has read it.
// Deleting the account deletes its folders, and a folder its places. A
// folder has one to-one relation and no @indexed field, so rhypedb copies
// it nowhere.
type ImapFolder {
    // "<account address key>\u001f<label id>".
    key: String @unique
    account: Account @on_delete(cascade)
    label_id: String
    // As the server spells it: modified UTF-7, the server's delimiter.
    name: String
    // Null for a flat namespace.
    delimiter: String
    // FolderRole, or null.
    role: Json
    uidvalidity: u32
    uidnext: u32
    // 0 for none (no CONDSTORE).
    highest_modseq: u64
    subscribed: Bool
    // RFC 8474 MAILBOXID, or null where the server has none.
    mailbox_id: String
    places: [ImapPlace] @inverse(ImapPlace.folder)
    attempts: [ImapCopyAttempt] @inverse(ImapCopyAttempt.folder)
}

// One copy of a message on an IMAP server: a UID in a folder
// (imap_state.rs). Its one to-one relation is its folder, so its reverse
// entry holds no copy of it; `message` is indexed, to find a message's
// copies, so rhypedb copies a place's scalars into that index, and they
// stay few and small.
type ImapPlace {
    // "<folder key>\u001f<uidvalidity>\u001f<uid>".
    key: String @unique
    folder: ImapFolder @on_delete(cascade)
    // The folder's label id, so a place reads without its folder.
    label_id: String
    uidvalidity: u32
    uid: u32
    // "<account address key>\u001f<message provider id>".
    message: String @indexed
    // The copy's flags as the server has them, a JSON list.
    flags: Json
    // 0 for none (no CONDSTORE).
    modseq: u64
    // The copy's INTERNALDATE; absent when the server gave none.
    arrived: DateTime
}

// A COPY or MOVE of a message into a folder whose copy the server has not
// been seen to make (imap_attempts.rs): it stops the copy being made twice,
// and is never counted as a copy. Its one to-one relation is its folder, so
// removing the folder, or the account, removes it.
type ImapCopyAttempt {
    // "<folder key>\u001f<message provider id>".
    key: String @unique
    folder: ImapFolder @on_delete(cascade)
    label_id: String
    // "<account address key>\u001f<message provider id>", indexed to find
    // a message's.
    message: String @indexed
    // The folder's UIDVALIDITY and UIDNEXT on the server just before the
    // command.
    uidvalidity: u32
    uidnext: u32
}
